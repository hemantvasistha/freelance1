# SheetFlow Engine — environment template. Copy to .env and fill in real values.
# Load with:  set -a; source .env; set +a   (or export the values in your shell)

# SQLite database file (relative paths resolve against the working directory)
SHEETFLOW_DB_PATH=sheetflow.db

# Where generated HTML/PDF invoices are written
SHEETFLOW_PDF_DIR=generated_invoices

# Public HTTPS base URL of this deployment. Required for invoice PDF links in the sheet:
# without it the webhook returns a server-local path that nobody can open.
SHEETFLOW_PUBLIC_BASE_URL=https://billing.example.com

# Shared secret required by the operator endpoints /dunning/run and /digest.
# Leave empty to disable those endpoints. Generate one with: python -c "import secrets;print(secrets.token_urlsafe(32))"
SHEETFLOW_ADMIN_TOKEN=change-me-admin-token

# Never send real client email / charge live cards while true
DRY_RUN=true

# Outbound email (used by the dunning dispatcher)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=billing@example.com
# Required only when DRY_RUN=false; the server refuses live delivery without it.
SMTP_PASSWORD=

# Digest recipient when a tenant has no --owner-email (one deployment = one operator).
SHEETFLOW_OWNER_EMAIL=

# In-process scheduler: daily reminders at SCHEDULER_HOUR, digest on Mondays.
SHEETFLOW_SCHEDULER_ENABLED=false
SHEETFLOW_SCHEDULER_HOUR=8
SHEETFLOW_SCHEDULER_POLL_SECONDS=300

# Razorpay (optional). Keys enable hosted card/UPI payment pages per invoice.
# The webhook secret alone is enough to reconcile payments automatically.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Job intake (official sources only; a human approves every lead).
# Comma-separated RSS URLs, e.g. https://example.com/jobs.rss
SHEETFLOW_JOB_FEEDS=
# Search terms for Freelancer.com's public API, e.g. invoice,excel,data entry
SHEETFLOW_FREELANCER_QUERIES=

# Optional: absolute path to a Unicode TTF for the ReportLab PDF fallback
# (defaults to Segoe UI / Arial on Windows, DejaVu on Linux)
# SHEETFLOW_PDF_FONT=C:/Windows/Fonts/segoeui.ttf
